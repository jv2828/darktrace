# Application Environment (development | production)
APP_ENV=development

# PostgreSQL Database Configuration
# If DATABASE_URL is set (e.g. on Render, Neon, Supabase), it is prioritized.
# Leading postgres:// or postgresql:// are automatically converted to postgresql+psycopg://
# DATABASE_URL=postgresql://darktrace:change_me@localhost:5432/darktrace
DB_NAME=darktrace
DB_USER=darktrace
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# Test Database Name
TEST_DB_NAME=darktrace_test

# Application Security & JWT Authentication
# In production (APP_ENV=production), SECRET_KEY must be a random string >= 32 characters
SECRET_KEY=change_me_later
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Optional Admin Bootstrap (creates initial admin on startup if no admin exists yet)
# BOOTSTRAP_ADMIN_EMAIL=admin@darktrace.local
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# BOOTSTRAP_ADMIN_FULL_NAME=Administrator

# Storage & Reports Directory (defaults to backend/reports)
# REPORTS_DIR=reports

# Frontend / CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Seeding Configuration
DEMO_USERNAME=analyst
DEMO_EMAIL=analyst@darktrace.org
DEMO_PASSWORD=DemoPassword123!


